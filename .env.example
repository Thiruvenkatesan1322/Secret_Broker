# ---------------------------------------------------------------------------
# NAMES ONLY. Never put real secret values in this file, and never commit a real
# .env. These are placeholders so you can see which variables the broker expects.
#
# Inject the REAL values at launch time, outside the project directory, e.g.:
#
#   1Password CLI:   op run --env-file=.env.op -- make up
#   Doppler:         doppler run -- make up
#   Docker secrets:  put files in ./secrets/ (git-ignored) - see docker-compose.yml
#
# The broker reads secrets from Docker secrets (/run/secrets) or the environment.
# It NEVER reads secrets from a file inside the project tree.
# ---------------------------------------------------------------------------

# Throwaway LOCAL tokens (NOT real credentials). Generate with `make secrets`.
BROKER_TOKEN=replace-with-throwaway-local-token
BROKER_ADMIN_TOKEN=replace-with-separate-admin-token

# Real upstream credentials - inject at runtime, do not hardcode here.
OPENAI_API_KEY=sk-DUMMY-do-not-commit
GITHUB_TOKEN=ghp_DUMMYdummydummydummydummy
